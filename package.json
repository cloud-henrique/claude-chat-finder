{
  "name": "claude-chat-finder",
  "version": "0.1.0",
  "description": "Open-source TUI to search and browse your Claude Code chat history — local, offline, and telemetry-free.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "ccf": "./src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build ./src/cli.tsx --compile --outfile dist/ccf",
    "build:darwin-arm64": "bun build ./src/cli.tsx --compile --target=bun-darwin-arm64 --outfile dist/ccf-darwin-arm64",
    "build:darwin-x64": "bun build ./src/cli.tsx --compile --target=bun-darwin-x64 --outfile dist/ccf-darwin-x64",
    "build:linux-arm64": "bun build ./src/cli.tsx --compile --target=bun-linux-arm64 --outfile dist/ccf-linux-arm64",
    "build:linux-x64": "bun build ./src/cli.tsx --compile --target=bun-linux-x64 --outfile dist/ccf-linux-x64",
    "build:windows-x64": "bun build ./src/cli.tsx --compile --target=bun-windows-x64 --outfile dist/ccf-windows-x64",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-arm64 && bun run build:linux-x64 && bun run build:windows-x64",
    "sign:macos": "codesign --force --sign - dist/ccf-darwin-arm64 dist/ccf-darwin-x64",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "react-devtools-core": "^8.0.0",
    "typescript": "^7.0.2"
  }
}
